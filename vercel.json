      "permanent": true
    },
    {
      "source": "/GAME/NEON-RACE/:path*",
      "destination": "/index.html?view=catalog",
      "permanent": false
    },
    {
      "source": "/GAME/NEON-RIDERS/:path*",
      "destination": "/index.html?view=catalog",
      "permanent": false
    },
    {
      "source": "/GAME/COUNTRY-DERBY/:path*",
      "destination": "/index.html?view=catalog",
      "permanent": false
    }
  ]
}
